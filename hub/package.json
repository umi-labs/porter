{
  "name": "porter-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "docker compose up -d --wait db && vitest run; s=$?; docker compose down -v; exit $s",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "db:generate": "pnpm -C packages/db generate",
    "auth:generate": "pnpm -C packages/db auth:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
