# Copy to .env. Placeholders only; never commit real values.
# Values below suit local development against docker-compose.dev.yml. Production (docker-compose.yml on Dokploy):
# DEPLOY.md has the table of required/optional variables and their production values.

# ---- production compose only ----
# Include the bundled MinIO (omit to use external S3/R2 via the S3_* variables)
COMPOSE_PROFILES=minio
# Password of the bundled Postgres; DATABASE_URL defaults to it in docker-compose.yml. URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=
# Bundled MinIO credentials; S3_ACCESS_KEY/S3_SECRET_KEY default to these in docker-compose.yml
MINIO_ROOT_USER=porter
MINIO_ROOT_PASSWORD=

# Postgres (matches docker-compose.dev.yml)
DATABASE_URL=postgres://porter:porter@localhost:55439/porter

# Better Auth
BETTER_AUTH_SECRET=change-me-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Staff sign-in: Google OAuth restricted to this Workspace domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_EMAIL_DOMAIN=example.com
# Slug of the one staff organization (created on first staff Google sign-in)
STAFF_ORG_SLUG=umi

# SMTP for client magic links
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=porter@example.com

# S3-compatible storage (matches docker-compose.dev.yml MinIO)
S3_ENDPOINT=http://localhost:59100
S3_BUCKET=porter-hub
S3_ACCESS_KEY=porter-dev
S3_SECRET_KEY=porter-dev-secret
# URL the CLI/browser can reach, baked into presigned URLs. Defaults to S3_ENDPOINT. Set it whenever S3_ENDPOINT
# is an internal name (e.g. http://storage:9000 on Dokploy): S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=
# Optional; defaults to us-east-1 (MinIO ignores it, R2 wants "auto")
S3_REGION=us-east-1

# 32 random bytes, base64 (openssl rand -base64 32): encrypts run secrets (AES-256-GCM). Required in production
# (web and worker refuse to start without it); never change it once secrets are stored.
HUB_SECRET_KEY=

# Worker (apps/worker): parallel remote runs (one per project at most, whatever this says)
WORKER_CONCURRENCY=1
# porter binary the worker runs (default: `porter` on PATH)
PORTER_BIN=
# Scratch space for runs, deleted after each run (default: <os tmpdir>/porter-worker). One per worker; never shared
# with a worker on another database.
WORKER_SCRATCH_DIR=

# Where extracted snapshots are cached for the project views (default: <os tmpdir>/porter-hub-cache).
# Web and worker must see the same dir (the worker's daily retention clears deleted projects from it).
HUB_CACHE_DIR=
# Cap on a snapshot's extracted size in bytes (default 2147483648)
HUB_SNAPSHOT_MAX_BYTES=

# Largest accepted client upload in bytes (default 21474836480 = 20 GiB)
UPLOAD_MAX_BYTES=

# Where the web finds Drizzle migrations at start (set in the Docker image; default: packages/db/migrations)
MIGRATIONS_DIR=
