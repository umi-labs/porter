# Copy to .env. Placeholders only; never commit real values.

# Postgres (matches docker-compose.yml dev db)
DATABASE_URL=postgres://porter:porter@localhost:55439/porter

# Better Auth
BETTER_AUTH_SECRET=change-me-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Staff sign-in: Google OAuth restricted to this Workspace domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_EMAIL_DOMAIN=example.com
# Slug of the one staff organization (created on first staff Google sign-in)
STAFF_ORG_SLUG=umi

# SMTP for client magic links
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=porter@example.com

# S3-compatible storage (matches docker-compose.yml dev MinIO)
S3_ENDPOINT=http://localhost:59100
S3_BUCKET=porter-hub
S3_ACCESS_KEY=porter-dev
S3_SECRET_KEY=porter-dev-secret
# URL the CLI/browser can reach, baked into presigned URLs. Defaults to S3_ENDPOINT. Set it whenever S3_ENDPOINT
# is an internal name (e.g. http://storage:9000 on Dokploy): S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=
# Optional; defaults to us-east-1 (MinIO ignores it, R2 wants "auto")
S3_REGION=us-east-1

# 32 random bytes, base64 (openssl rand -base64 32): encrypts run secrets (AES-256-GCM)
HUB_SECRET_KEY=

# Parallel remote runs the worker may execute
WORKER_CONCURRENCY=1
