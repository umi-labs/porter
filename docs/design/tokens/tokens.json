{
  "$description": "Porter design tokens, shared by the desktop app (GPUI) and the hub (Next.js + Tailwind). Source of truth for theme.rs and globals.css.",
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F7F7F8",
      "panel": "#EFEFF2",
      "hover": "#E9E9EE",
      "border": "#E3E3E8",
      "border-strong": "#CFCFD6",
      "text": "#18181B",
      "muted": "#565662",
      "faint": "#6E6E7A",
      "accent": "#3E4FD6",
      "accent-bg": "#ECEEFC",
      "on-accent": "#FFFFFF",
      "ok": "#17803D",
      "ok-bg": "#E6F5EB",
      "on-ok": "#FFFFFF",
      "warn": "#9A5800",
      "warn-bg": "#FFF3DC",
      "err": "#C42B2B",
      "err-bg": "#FDECEC",
      "err-solid": "#C42B2B",
      "on-err": "#FFFFFF",
      "int": "#7339BD",
      "int-bg": "#F2EBFC",
      "dry": "#3B4A6B",
      "dry-bg": "#EEF1F7",
      "dry-hatch": "#E2E7F0",
      "dry-border": "#8391B0",
      "stale-bg": "#F1F1F4"
    },
    "dark": {
      "bg": "#111113",
      "surface": "#17171A",
      "panel": "#1E1E22",
      "hover": "#26262B",
      "border": "#2A2A30",
      "border-strong": "#3A3A42",
      "text": "#EDEDF0",
      "muted": "#A3A3AE",
      "faint": "#8C8C98",
      "accent": "#8C98FF",
      "accent-bg": "#1E2142",
      "on-accent": "#0E1030",
      "ok": "#4ADE80",
      "ok-bg": "#0F2A19",
      "on-ok": "#0B1F12",
      "warn": "#F5B83D",
      "warn-bg": "#2B210C",
      "err": "#FF7A7A",
      "err-bg": "#301515",
      "err-solid": "#B42A2A",
      "on-err": "#2A0F0F",
      "int": "#C3A3FF",
      "int-bg": "#231B33",
      "dry": "#AEBBDA",
      "dry-bg": "#1A1F2B",
      "dry-hatch": "#222939",
      "dry-border": "#56648A",
      "stale-bg": "#1C1C20"
    }
  },
  "font": {
    "desktop": { "sans": "system (SF Pro)", "mono": "ui-monospace, SF Mono, Menlo" },
    "hub": { "sans": "Inter, system-ui, sans-serif", "mono": "ui-monospace, SF Mono, Menlo" }
  },
  "type": {
    "desktop": {
      "title": [20, 26, 600],
      "heading": [15, 20, 600],
      "body": [13, 18, 400],
      "dense": [12, 16, 400],
      "micro": [11, 14, 400],
      "mono": [12, 16, 400]
    },
    "hub": {
      "display": [28, 34, 600],
      "title": [20, 28, 600],
      "heading": [16, 24, 600],
      "body": [15, 24, 400],
      "small": [13, 20, 400]
    },
    "$note": "[size px, line-height px, weight]. Numbers use tabular figures."
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 14, "full": 9999 },
  "row": { "desktop-table": 28, "desktop-sidebar": 32, "hub-min-touch": 44 },
  "state": {
    "not-run":     { "fg": "muted", "bg": "transparent", "border": "border-strong dashed", "glyph": "hollow circle" },
    "running":     { "fg": "accent", "bg": "accent-bg", "border": "none", "glyph": "dotted ring + %" },
    "clean":       { "fg": "ok", "bg": "ok-bg", "border": "none", "glyph": "filled circle ✓", "rule": "only when written; for load, only after apply" },
    "warnings":    { "fg": "warn", "bg": "warn-bg", "border": "none", "glyph": "square !" },
    "errors":      { "fg": "err", "bg": "err-bg", "border": "err", "glyph": "filled circle !" },
    "failed":      { "fg": "#FFFFFF", "bg": "err-solid", "border": "none", "glyph": "white circle ✕" },
    "interrupted": { "fg": "int", "bg": "int-bg", "border": "none", "glyph": "ring ‖" },
    "stale":       { "fg": "muted", "bg": "stale-bg", "border": "border-strong", "glyph": "↻", "rule": "modifier on the previous result: dim to 62% and give the reason" },
    "dry-run":     { "fg": "dry", "bg": "hatch(dry-bg, dry-hatch)", "border": "dry-border dashed", "glyph": "dashed ring" },
    "skipped":     { "fg": "faint", "bg": "transparent", "border": "border", "glyph": "ring –" }
  }
}
