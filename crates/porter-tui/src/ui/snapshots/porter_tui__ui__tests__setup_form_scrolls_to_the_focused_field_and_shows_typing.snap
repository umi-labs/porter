"┌Setup: no porter.toml here (credentials are never typed here)─────────────────┐"
"│Project                                                                       │"
"│  name*          demo                                                         │"
"│Source                                                                        │"
"│  adapter*       ‹wordpress›                                                  │"
"│Connector: crawl a live site                                                  │"
"│  use            ‹no›                                                         │"
"│Connector: WordPress export (WXR)                                             │"
"│  use            ‹no›                                                         │"
"│Connector: WordPress REST API                                                 │"
"│  use            ‹no›                                                         │"
"│Connector: WordPress database dump                                            │"
"│  use            ‹no›                                                         │"
"│Connector: Umbraco JSON export                                                │"
"│  use            ‹yes›                                                        │"
"│  export files*  a.json, b.json                                               │"
