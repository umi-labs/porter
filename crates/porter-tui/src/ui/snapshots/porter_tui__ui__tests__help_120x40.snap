---
source: crates/porter-tui/src/ui/mod.rs
expression: "render(&app, 120, 40)"
---
"┌Project─────────────┌Keys (j/k scroll, esc closes)───────────────────────────────────────────────┐────────────────────┐"
"│demo  wordpress →   │y         cancel the run and quit                      quit prompt          │                    │"
"│0 err · 0 warn · 0 i│n/esc     keep running                                 quit prompt          │                    │"
"└────────────────────│y         write to the live CMS                        apply prompt         │                    │"
"┌Stages──────────────│n/esc     cancel (any other key too)                   apply prompt         │                    │"
"│> · analyse    not r│↓/tab     next choice                                  resolve box          │                    │"
"│  · extract    not r│↑/S-tab   previous choice                              resolve box          │                    │"
"│  · normalise  not r│enter     confirm the resolution                       resolve box          │                    │"
"│  · schema     not r│backspace delete a note character                      resolve box          │                    │"
"│  · load       not r│esc       cancel                                       resolve box          │                    │"
"│  · verify     not r│j/↓       scroll down                                  help                 │                    │"
"└────────────────────│k/↑       scroll up                                    help                 │                    │"
"┌Issues──────────────│?/esc     close help                                   help                 │                    │"
"│  ✗ missing-media   │ctrl-c    close help, cancel the run; again to quit    help                 │                    │"
"│  ⚠ unresolved-link │enter     apply the filter                             filter box           │                    │"
"│  i unmapped-field  │esc       clear the filter                             filter box           │                    │"
"│                    │backspace delete a character                           filter box           │                    │"
"│                    │esc       close Detail, go back                        Detail               │                    │"
"│                    │j/↓       move in the open issue list                  open issue           │                    │"
"│                    │k/↑       move up in the open issue list               open issue           │                    │"
"│                    │pgdn      page down in the open list                   open issue           │                    │"
"└────────────────────│pgup      page up in the open list                     open issue           │                    │"
"┌Items 1/50000───────│enter     open the issue, or its item                  open issue           │                    │"
"│  ✓ document /about │x         resolve the issue                            open issue           │                    │"
"│  ✗ document /contac│g         jump to the issue's item                     open issue           │                    │"
"│  ⚠ media    /upload│j/↓       move down                                    Stages               │                    │"
"│                    │k/↑       move up                                      Stages               │                    │"
"│                    │space     run the selected stage                       Stages               │                    │"
"│                    │j/↓       move down                                    Issues, Items        │                    │"
"│                    │k/↑       move up                                      Issues, Items        │                    │"
"└────────────────────│pgdn      move a page down                             Issues, Items        │────────────────────┘"
"┌Log─────────────────│pgup      move a page up                               Issues, Items        │────────────────────┐"
"│                    │enter     open in Detail, drill in                     Issues, Items        │                    │"
"│                    │/         filter (fuzzy, incremental)                  Issues, Items        │                    │"
"│                    │f         cycle all, open, errors only                 Issues, Items        │                    │"
"│                    │esc       clear the filter                             Issues, Items        │                    │"
"│                    │y         copy the item or issue id                    Issues, Items        │                    │"
"│                    │tab       focus the next panel                         anywhere             │                    │"
"└────────────────────│S-tab     focus the previous panel                     anywhere             │────────────────────┘"
"j/k scroll · esc clos└────────────────────────────────────────────────────────────────────────────┘                     "
