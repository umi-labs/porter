---
source: crates/porter-tui/src/ui/mod.rs
expression: "render(&app, 120, 40)"
---
"┌Project─────────────┌Keys (j/k scroll, esc closes)───────────────────────────────────────────────┐────────────────────┐"
"│demo  wordpress →   │y         cancel the run and quit                quit prompt                │                    │"
"│0 err · 0 warn · 0 i│n/esc     keep running                           quit prompt                │                    │"
"└────────────────────│↓/tab     next choice                            resolve box                │                    │"
"┌Stages──────────────│↑/S-tab   previous choice                        resolve box                │                    │"
"│> · analyse    not r│enter     confirm the resolution                 resolve box                │                    │"
"│  · extract    not r│esc       cancel                                 resolve box                │                    │"
"│  · normalise  not r│j/↓       scroll down                            help                       │                    │"
"│  · schema     not r│k/↑       scroll up                              help                       │                    │"
"│  · load       not r│?/esc     close help                             help                       │                    │"
"│  · verify     not r│enter     apply the filter                       filter box                 │                    │"
"└────────────────────│esc       clear the filter                       filter box                 │                    │"
"┌Issues──────────────│backspace delete a character                     filter box                 │                    │"
"│  ✗ missing-media   │esc       close Detail, go back                  Detail                     │                    │"
"│  ⚠ unresolved-link │x         resolve the issue                      open issue                 │                    │"
"│  i unmapped-field  │g         jump to the issue's item               open issue                 │                    │"
"│                    │j/↓       move down                              Stages                     │                    │"
"│                    │k/↑       move up                                Stages                     │                    │"
"│                    │space     run the selected stage                 Stages                     │                    │"
"│                    │j/↓       move down                              Issues, Items              │                    │"
"│                    │k/↑       move up                                Issues, Items              │                    │"
"└────────────────────│pgdn      move a page down                       Issues, Items              │                    │"
"┌Items 1/50000───────│pgup      move a page up                         Issues, Items              │                    │"
"│  ✓ document /about │enter     open in Detail, drill in               Issues, Items              │                    │"
"│  ✗ document /contac│/         filter (fuzzy, incremental)            Issues, Items              │                    │"
"│  ⚠ media    /upload│f         cycle all, open, errors only           Issues, Items              │                    │"
"│                    │esc       clear the filter                       Issues, Items              │                    │"
"│                    │y         copy the item or issue id              Issues, Items              │                    │"
"│                    │tab       focus the next panel                   anywhere                   │                    │"
"│                    │S-tab     focus the previous panel               anywhere                   │                    │"
"└────────────────────│1-4       focus a panel by number                anywhere                   │────────────────────┘"
"┌Log─────────────────│R         run all stages                         anywhere                   │────────────────────┐"
"│                    │l         load, dry run                          anywhere                   │                    │"
"│                    │L         load, apply                            anywhere                   │                    │"
"│                    │v         verify                                 anywhere                   │                    │"
"│                    │ctrl-c    cancel the run; again to quit          anywhere                   │                    │"
"│                    │c         cancel the running stage               anywhere                   │                    │"
"│                    │o         open the HTML report                   anywhere                   │                    │"
"└────────────────────│e         edit porter.toml                       anywhere                   │────────────────────┘"
"j/k scroll · esc clos└────────────────────────────────────────────────────────────────────────────┘                     "
