# Landmark acceptance: porter's mapping onto the Landmark app's collections, globals and blocks.
# acceptance/run.sh copies this to acceptance/landmark/project/porter.toml, replacing @LANDMARK_DIR@
# and @SNAPSHOT_DIR@. Config only: slugs, field names and redirect paths, no content.
# Source of truth for the type mapping: the Landmark importer's TYPES table (import-content.ts).

[project]
name = "landmark"

[source]
adapter = "wordpress"

[[connectors]]
kind = "wp-db"
dump = "@LANDMARK_DIR@/wp-source/prodlandmark.sql.gz"
wp_root = "@LANDMARK_DIR@/wp-source/wp"
# The uploads were copied next to the WordPress tree, not inside it.
uploads_dir = "@LANDMARK_DIR@/wp-source/uploads"

# @CRAWL@ (run.sh drops this block with --local-only)
[[connectors]]
kind = "crawl"
url = "file://@SNAPSHOT_DIR@"

[destination]
adapter = "payload"
# Landmark's app on a fresh, throwaway database (see README.md); never its real one.
url = "http://localhost:3000"
api_key_env = "PORTER_PAYLOAD_API_KEY"
auth_collection = "users"
config_dir = "@LANDMARK_DIR@/src"

[verify]
site_url = "http://localhost:3000"

[mapping]
locales = { mode = "skip" }
taxonomies = { category = "categories", post_tag = "tags" }
forms = { collection = "forms", submissions = "form-submissions" }
media = { collection = "media", folders = true }
# Each item's earlier URL, kept in an ACF field
redirects = { collection = "redirects", from_fields = ["acf.old_site_url"] }
settings = { global = "settings", front_page = "homePage" }

[mapping.menus]
global = "navigation"
fields = { main-menu = "mainMenu", header-left-menu = "headerLeftMenu", footer-menu = "footerMenu", members-navigation = "membersNavigation", employee-benefits = "employeeBenefits" }

[[mapping.blocks]]
match = { kind = "rich-text" }
to = "content"
fields = { text = "richText" }

[[mapping.blocks]]
match = { kind = "image" }
to = "mediaBlock"
fields = { media = "media" }

[[mapping.blocks]]
match = { kind = "video" }
to = "video"
fields = { url = "url" }

[[mapping.blocks]]
match = { kind = "form-ref" }
to = "formBlock"
fields = { form = "form" }

[[mapping.blocks]]
match = { kind = "raw" }
to = "code"
fields = { html = "code" }

[[mapping.blocks]]
match = { kind = "divider" }
to = "divider"

# Not mapped: Divi galleries hold their images as child blocks, and the gallery block wants
# them as `images` array rows; a block-children-to-array mapping doesn't exist yet, so the
# few galleries are reported as unsupported blocks.

[[mapping.blocks]]
match = { kind = "accordion" }
to = "accordion"

[[mapping.blocks]]
match = { kind = "tabs" }
to = "tabs"

[[mapping.blocks]]
match = { kind = "slider" }
to = "slider"


[mapping.types.page]
to = "pages"
path = "{parent.path}/{slug}/"
key_field = "legacyId"
key_type = "number"
status = { private = "draft", draft = "skip", scheduled = "skip" }
[mapping.types.page.fields]
"acf.booking_widget" = { drop = true, reason = "not used on the new site" }
"acf.member_offer" = { drop = true, reason = "not used on the new site" }
"acf.members_offers" = { drop = true, reason = "not used on the new site" }
"acf.old_site_url" = { drop = true, reason = "becomes a redirect (mapping.redirects.from_fields)" }
"acf.slides" = { drop = true, reason = "not used on the new site" }
"seo.title" = { to = "meta.title" }
"seo.description" = { to = "meta.description" }
"seo.og_image" = { to = "meta.image" }
"seo.noindex" = { to = "meta.noindex" }
"content" = { to = "layout" }
"featured_image" = { to = "featuredImage" }
"created" = { to = "publishedAt" }

